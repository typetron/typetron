{
	"jsc": {
		"parser": {
			"syntax": "typescript",
			"decorators": true
		},
		"transform": {
			"legacyDecorator": true,
			"decoratorMetadata": true
		},
		"target": "es2020",
		"baseUrl": "./",
		"paths": {
			"App/*": [
				"./*"
			]
		}
	},
	"module": {
		"type": "commonjs"
	},
	"sourceMaps": true
}
